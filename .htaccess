# ====================================================================
# eParivartan Canonical SEO & Redirect Rules
# ====================================================================
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Prevent directory listings & prevent content negotiation conflicts
Options -Indexes -MultiViews

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Redirect www to non-www (Single Canonical Host)
# Users typing www.eparivartan.com are cleanly routed to eparivartan.com
RewriteCond %{HTTP_HOST} ^www\.eparivartan\.com [NC]
RewriteRule ^(.*)$ https://eparivartan.com/$1 [L,R=301]

# 3. Canonicalize /index.html and legacy /index.php to root /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.(html|php)\ HTTP/ [NC]
RewriteRule ^index\.(html|php)$ https://eparivartan.com/ [R=301,L]

# 4. Clean URLs for Blog & Insights (Rewrite extensionless to .html)
# Maps /blog/{slug} -> /blog/{slug}.html if the file exists
RewriteCond %{DOCUMENT_ROOT}/blog/$1.html -f
RewriteRule ^blog/([^/]+)/?$ /blog/$1.html [L,QSA]

# Maps /insights/{slug} -> /blog/{slug}.html if the file exists
RewriteCond %{DOCUMENT_ROOT}/blog/$1.html -f
RewriteRule ^insights/([^/]+)/?$ /blog/$1.html [L,QSA]

# Explicit Clean URLs for Insights / Blogs
RewriteRule ^blog/parivartan-means-change-new-website/?$ /blog/parivartan-means-change-new-website.html [L,QSA]
RewriteRule ^insights/parivartan-means-change-new-website/?$ /blog/parivartan-means-change-new-website.html [L,QSA]
RewriteRule ^insights/website-launch/?$ /blog/parivartan-means-change-new-website.html [L,QSA]

RewriteRule ^blog/24-years-building-technology-eparivartan/?$ /blog/24-years-building-technology-eparivartan.html [L,QSA]
RewriteRule ^insights/24-years-building-technology-eparivartan/?$ /blog/24-years-building-technology-eparivartan.html [L,QSA]

RewriteRule ^blog/people-behind-parivartan/?$ /blog/people-behind-parivartan.html [L,QSA]
RewriteRule ^insights/people-behind-parivartan/?$ /blog/people-behind-parivartan.html [L,QSA]

RewriteRule ^blog/people-who-inspired-parivartan/?$ /blog/people-who-inspired-parivartan.html [L,QSA]
RewriteRule ^insights/people-who-inspired-parivartan/?$ /blog/people-who-inspired-parivartan.html [L,QSA]

RewriteRule ^blog/founders-in-frame-parivartan-stories/?$ /blog/founders-in-frame-parivartan-stories.html [L,QSA]
RewriteRule ^insights/founders-in-frame-parivartan-stories/?$ /blog/founders-in-frame-parivartan-stories.html [L,QSA]

RewriteRule ^blog/estic-2025-digital-platform/?$ /blog/estic-2025-digital-platform.html [L,QSA]
RewriteRule ^insights/estic-2025-digital-platform/?$ /blog/estic-2025-digital-platform.html [L,QSA]

RewriteRule ^blog/ai-visibility-for-businesses/?$ /blog/ai-visibility-for-businesses.html [L,QSA]
RewriteRule ^insights/ai-visibility-for-businesses/?$ /blog/ai-visibility-for-businesses.html [L,QSA]

RewriteRule ^blog/sherwood-school-seo-ai-visibility/?$ /blog/sherwood-school-seo-ai-visibility.html [L,QSA]
RewriteRule ^insights/sherwood-school-seo-ai-visibility/?$ /blog/sherwood-school-seo-ai-visibility.html [L,QSA]

RewriteRule ^blog/cacm-2026-technology-creative-collaboration/?$ /blog/cacm-2026-technology-creative-collaboration.html [L,QSA]
RewriteRule ^insights/cacm-2026-technology-creative-collaboration/?$ /blog/cacm-2026-technology-creative-collaboration.html [L,QSA]

RewriteRule ^blog/viyash-listed-company-website-development/?$ /blog/viyash-listed-company-website-development.html [L,QSA]
RewriteRule ^insights/viyash-listed-company-website-development/?$ /blog/viyash-listed-company-website-development.html [L,QSA]

RewriteRule ^blog/arci-government-website-technology-partnership/?$ /blog/arci-government-website-technology-partnership.html [L,QSA]
RewriteRule ^insights/arci-government-website-technology-partnership/?$ /blog/arci-government-website-technology-partnership.html [L,QSA]

RewriteRule ^blog/why-website-maintenance-matters/?$ /blog/why-website-maintenance-matters.html [L,QSA]
RewriteRule ^insights/why-website-maintenance-matters/?$ /blog/why-website-maintenance-matters.html [L,QSA]

RewriteRule ^blog/mjcet-parivartan-design-technology-journey/?$ /blog/mjcet-parivartan-design-technology-journey.html [L,QSA]
RewriteRule ^insights/mjcet-parivartan-design-technology-journey/?$ /blog/mjcet-parivartan-design-technology-journey.html [L,QSA]

RewriteRule ^blog/custom-software-vs-ready-made-solutions/?$ /blog/custom-software-vs-ready-made-solutions.html [L,QSA]
RewriteRule ^insights/custom-software-vs-ready-made-solutions/?$ /blog/custom-software-vs-ready-made-solutions.html [L,QSA]

RewriteRule ^blog/rithika-woocommerce-to-shopify-migration/?$ /blog/rithika-woocommerce-to-shopify-migration.html [L,QSA]
RewriteRule ^insights/rithika-woocommerce-to-shopify-migration/?$ /blog/rithika-woocommerce-to-shopify-migration.html [L,QSA]
</IfModule>

# Custom 404 Error Page
ErrorDocument 404 /404.html
